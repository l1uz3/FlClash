# punch-server agent. Copy to /etc/punch/punch.env (mode 600) on the firewalled server.
# Needs root (or CAP_NET_RAW + CAP_NET_ADMIN) for tcpdump and iptables, and both installed.

# Listen only where the coordinator can reach it; never on a public address.
PUNCH_AGENT_LISTEN=10.0.0.2:48081
# Same value as the coordinator's PUNCH_AGENT_KEY.
PUNCH_AGENT_KEY=
# Interface the clients' SYNs arrive on.
PUNCH_IFACE=eth0
# The proxy server tunnel streams are forwarded to (e.g. sing-box or Xray shadowsocks inbound).
PUNCH_TARGET=127.0.0.1:34120
# Per-stream yamux window in KiB; must not be below the clients' punch.window for full speed.
#PUNCH_WINDOW_KIB=16384
