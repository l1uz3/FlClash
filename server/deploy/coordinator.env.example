# punch-server coordinator. Copy to /etc/punch/punch.env (mode 600).
# Runs on a host with a public IP that clients and the agent can both reach.

# Where clients connect: TLS control port and the two plaintext NAT-probe ports.
# Clients must use the same three ports (punch.coordinator / punch.probe-ports).
PUNCH_LISTEN=:48080
PUNCH_PROBE_A=:48082
PUNCH_PROBE_B=:48084

# The agent on the firewalled server, over a private link if you have one.
PUNCH_AGENT=10.0.0.2:48081
# Shared secret between coordinator and agent; generate with: openssl rand -hex 32
PUNCH_AGENT_KEY=

# Public IP of the firewalled server, as clients reach it.
PUNCH_SERVER_IP=203.0.113.10
# Port on that server clients send their sacrificial SYNs to. Must be closed (nothing listening).
PUNCH_LEARN_PORT=45000
# Source ports the agent dials cone-NAT clients back from.
PUNCH_CONE_PORT_BASE=49000
PUNCH_CONE_PORT_COUNT=500

PUNCH_TOKENS=/etc/punch/tokens
PUNCH_STATE=/var/lib/punch

# --- Allow-list (only needed for clients behind symmetric NAT, e.g. mobile data) ---
# Leave PUNCH_FW_ADD_URL empty to accept port-preserving (cone) NAT clients only.
#
# An HTTPS endpoint that allow-lists whoever calls it. The client only relays a raw socket to it;
# TLS and the request run on this host, so the URL (and any secret in it) never reaches clients.
PUNCH_FW_ADD_URL=
# SHA-256 of that endpoint's certificate:
#   openssl s_client -connect HOST:PORT </dev/null 2>/dev/null | openssl x509 -outform DER | sha256sum
PUNCH_FW_ADD_PIN=
# Regex over the response body: group 1 = IP, optional group 2 = prefix length.
#PUNCH_FW_ADD_RESULT="currentIp":"([0-9.]+)\\?/(\d+)"
# Prefix to remove when the endpoint reports a bare IP.
#PUNCH_FW_PREFIX=24
# Command that removes an entry; {cidr} is replaced (or the CIDR is appended).
# It must exit 0 only once the entry is gone. See fw-remove.example.sh.
PUNCH_FW_REMOVE=/etc/punch/fw-remove.sh {cidr}
# Seconds to wait after removal before clients open their real tuples.
#PUNCH_REMOVE_WAIT=6
